# Written by `supervaizer login` (never commit the real .env)
SUPERVAIZE_API_KEY=
SUPERVAIZE_WORKSPACE_ID=
SUPERVAIZE_API_URL=https://app.supervaize.com
SUPERVAIZER_WORKSPACE_AUTH_REQUIRED=true
SUPERVAIZER_WORKSPACE_AUTH_ISSUER=
SUPERVAIZER_WORKSPACE_AUTH_JWKS_URL=

# Add yourself:
# a fixed ID, from `uuidgen` (Mac/Linux) or `[guid]::NewGuid()` (Windows PowerShell)
SUPERVAIZER_SERVER_ID=
# in production; with a tunnel, pass --public-url at startup instead
SUPERVAIZER_PUBLIC_URL=
# job states; point it to a persistent disk in production
DATA_DIR=./data
